{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kentra-io/milestoned-plan-dag/v0.1.0/schema/plan.schema.json",
  "title": "milestoned-plan-dag plan",
  "description": "A machine-first plan: a DAG of verifiable milestones. Shape validation only; the CLI is authoritative for semantic DAG rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "milestones"],
  "properties": {
    "schemaVersion": {
      "description": "Semantic version without a v prefix, beginning at 0.1.0.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/milestone" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "goal", "contract", "steps"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "slug": { "$ref": "#/$defs/slug" },
        "goal": { "type": "string", "minLength": 1 },
        "deliverables": { "$ref": "#/$defs/deliverables" },
        "contract": { "$ref": "#/$defs/contract" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "depends-on": {
          "type": "array",
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "deliverables": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "create": { "type": "array", "items": { "type": "string" } },
            "modify": { "type": "array", "items": { "type": "string" } },
            "test": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "criteria", "paths"],
      "properties": {
        "check": {
          "description": "A single executable command, or the sentinel 'none'.",
          "type": "string",
          "minLength": 1
        },
        "criteria": { "$ref": "#/$defs/criteria" },
        "paths": {
          "description": "Allowed write-set. [] means an empty diff; ['**'] means unconfined.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "criteria": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["then"],
            "properties": {
              "name": { "type": "string" },
              "given": { "type": "string" },
              "when": { "type": "string" },
              "then": { "type": "string" }
            }
          }
        }
      ]
    },
    "step": {
      "oneOf": [
        { "type": "string", "pattern": "^\\[[ xX]\\]" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "type": "string", "pattern": "^\\[[ xX]\\]" },
            "files": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    }
  }
}
